# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Console -> Account, and Messaging -> WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Local dev: http://localhost:3000 -- Production: your Vercel deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Any random string -- protects /api/cron/* from being hit by the public.
# Reservations expire via pg_cron (supabase/migrations/0004); the route is a manual fallback.
CRON_SECRET=

# Login code delivery: sms | whatsapp. Use whatsapp once the Twilio Messaging Service has an
# approved WhatsApp Business sender (Indian carriers filter non-DLT SMS).
NEXT_PUBLIC_OTP_CHANNEL=sms
